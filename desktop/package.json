{
  "name": "note-desktop",
  "productName": "Note",
  "version": "0.1.0",
  "description": "Desktop wrapper for the Note daily planning app",
  "license": "MIT",
  "author": "shuntia <shuntia@shuntia.net>",
  "homepage": "https://github.com/shuntia/note",
  "private": true,
  "main": "main.js",
  "desktopName": "note-desktop.desktop",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev --url=http://localhost:5173",
    "test": "node --test",
    "dist": "electron-builder --linux AppImage deb"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "net.shuntia.note",
    "productName": "Note",
    "files": ["main.js", "preload.js", "server-url.js", "updates.js", "setup.html", "setup-preload.js", "offline.html", "icons/**"],
    "directories": { "output": "dist" },
    "publish": { "provider": "github", "owner": "shuntia", "repo": "note" },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "icons",
      "category": "Office",
      "executableName": "note-desktop"
    },
    "deb": { "maintainer": "shuntia <shuntia@shuntia.net>" },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "icons/512x512.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": { "NSMicrophoneUsageDescription": "Note listens while you are on a call with it." }
    },
    "win": { "target": ["nsis"], "icon": "icons/256x256.png" },
    "nsis": { "artifactName": "${productName}-Setup-${version}.${ext}" }
  }
}
